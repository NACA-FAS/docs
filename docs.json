{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Five Stack",
  "colors": {
    "primary": "#D62828",
    "light": "#FF3030",
    "dark": "#A81F1F"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Community Overview",
            "pages": [
              "welcome"
            ]
          }
        ]
      },
      {
        "tab": "Staff Hub",
        "groups": [
          {
            "group": "Staff Hub",
            "pages": [
              "staffing/staff-guidelines"
            ]
          }
        ]
      },
      {
        "tab": "Contact & Support",
        "groups": [
          {
            "group": "Contact & Support",
            "pages": [
              "contact/contact-and-support"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark_new.svg",
    "href": "https://fivestackrblx.com/welcome"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "fonts": {
    "family": "Montserrat"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "icons": {
    "library": "fontawesome"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome",
      "permanent": true
    }
  ],
  "favicon": "/logo/favicon_new.svg"
}
